# Copy to config.local.env and fill in the real identifiers.
#
#   cp config.example.env config.local.env
#   ./scripts/run-sql.sh sql/dashboard-metrics.sql --dry-run
#
# config.local.env is git-ignored and must never be committed. Every query in
# this repository is written against the placeholders below and contains no
# identifier of its own — that is what makes the SQL publishable.
#
# NOTE FOR READERS WITHOUT ACCESS TO THE ORIGINAL DATA
# ----------------------------------------------------
# These queries are not executable outside the organisation that holds the
# production data. They are published so the logic can be read and audited, and
# so a team with its own log can adapt them: the three diagnostic tests of
# Section 4 are aggregate queries over data that any deployed recommender
# already produces. See README.md.

# --- Projects ---
# The billing project may differ from the project hosting the tables: BigQuery
# allows cross-project reads, and an account often has jobs.create in few
# projects and read access in others.
project_insights=FILL_IN   # training base, feature store, prediction history
project_billing=FILL_IN    # where query jobs are charged

# --- Datasets ---
# Each dataset lives in a specific project. Crossing the wrong pair returns
# "Not found: Dataset", which is INDISTINGUISHABLE from lack of permission —
# BigQuery hides the existence of what you cannot see. Check the project before
# concluding that access was not granted.
dataset_recommendation=FILL_IN   # project_insights: training base / feature store / history

# --- Tables ---
table_prediction_history=FILL_IN   # one row per deal scored in a request
table_feature_store=FILL_IN        # current deal attributes; keeps no history
